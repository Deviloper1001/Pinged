# ─── Database (Supabase Postgres) ─────────────────────────────────────────────
# Pooled connection (via PgBouncer) — used by the app at runtime.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:6543/postgres?pgbouncer=true
# Direct connection — used by Prisma for migrations / db push.
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# ─── Supabase (Storage + Realtime) ────────────────────────────────────────────
# Server-side. Found in: Supabase Dashboard → Project Settings → API →
# "service_role secret". NEVER expose this to the browser.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Client-side (safe to expose). Found in: Supabase Dashboard → Project Settings
# → API → "anon public".
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Random long string used to sign session JWTs. Generate with:
#   openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# ─── Local dev only ──────────────────────────────────────────────────────────
# For local SQLite dev (NOT for Vercel). Leave unset on Vercel.
# DATABASE_URL=file:./db/custom.db
